<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item android:top="4dp"><shape><solid android:color="#FFE7AA9F" /><corners android:radius="28dp" /></shape></item>
            <item android:bottom="4dp"><shape><solid android:color="#FFF5C2B9" /><corners android:radius="28dp" /></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp"><shape><solid android:color="@color/danger" /><corners android:radius="28dp" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp"><shape><solid android:color="@color/danger_dark" /><corners android:radius="28dp" /></shape></item>
            <item android:bottom="4dp"><shape><solid android:color="@color/danger" /><corners android:radius="28dp" /></shape></item>
        </layer-list>
    </item>
</selector>
