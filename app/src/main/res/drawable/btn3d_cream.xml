<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item android:top="4dp"><shape><solid android:color="@color/surface3" /><corners android:radius="28dp" /></shape></item>
            <item android:bottom="4dp"><shape><solid android:color="@color/surface2" /><corners android:radius="28dp" /></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp"><shape><solid android:color="@color/surface" /><corners android:radius="28dp" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp"><shape><solid android:color="@color/outline" /><corners android:radius="28dp" /></shape></item>
            <item android:bottom="4dp"><shape><solid android:color="@color/surface" /><corners android:radius="28dp" /></shape></item>
        </layer-list>
    </item>
</selector>
