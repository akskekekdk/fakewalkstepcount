<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

<!-- ===================== 전체 사진(그리드) 화면 ===================== -->
<LinearLayout
    android:id="@+id/gridScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- 선택 모드에서만 보이는 '취소' -->
        <Button
            android:id="@+id/btnSelCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/btn_small"
            android:paddingHorizontal="12dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/gridTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사진 정리"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gridCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGridUndo"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_small"
            android:paddingHorizontal="12dp"
            android:text="↶"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnOpenTrash"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_small"
            android:paddingHorizontal="12dp"
            android:text="🗑"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_small"
            android:paddingHorizontal="12dp"
            android:text="⚙"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- 일반 모드: '선택' / 선택 모드: '전체' -->
        <Button
            android:id="@+id/btnSelect"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/btn_small"
            android:paddingHorizontal="14dp"
            android:text="선택"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 전체 / 즐겨찾기 탭 -->
    <LinearLayout
        android:id="@+id/tabRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/tabAll"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/btn_small"
            android:text="전체 사진"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/tabFav"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/btn_small"
            android:text="♥ 즐겨찾기"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/gridBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF8F00"
        android:padding="10dp"
        android:text="⚡ 탭해서 '미디어 관리' 권한을 켜면 확인창 없이 버튼 한 번에 바로 휴지통으로 보내집니다"
        android:textColor="#000000"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:horizontalSpacing="2dp"
            android:verticalSpacing="2dp"
            android:numColumns="4"
            android:stretchMode="columnWidth" />

        <TextView
            android:id="@+id/gridEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/gridLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 선택 모드 하단 바 -->
    <LinearLayout
        android:id="@+id/selBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnTrashSelected"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/btn_trash"
            android:text="🗑 휴지통"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

<!-- ===================== 한 장씩 보기 화면 ===================== -->
<LinearLayout
    android:id="@+id/viewerScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- 상단 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/btn_small"
            android:paddingHorizontal="14dp"
            android:text="‹ 전체"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnFav"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_small"
            android:paddingHorizontal="14dp"
            android:text="♡"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnUndo"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/btn_small"
            android:paddingHorizontal="14dp"
            android:text="↶"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 확인창 없이 삭제하려면 권한 안내 -->
    <TextView
        android:id="@+id/manageBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF8F00"
        android:padding="10dp"
        android:text="⚡ 탭해서 '미디어 관리' 권한을 켜면 확인창 없이 버튼 한 번에 바로 휴지통으로 보내집니다"
        android:textColor="#000000"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 사진 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.photoclean.app.ZoomImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="6dp"
        android:text="← 다음  ·  → 이전  ·  ↑ 휴지통  ·  두 손가락/더블탭: 확대"
        android:textColor="#777777"
        android:textSize="12sp" />

    <!-- 전체 사진 썸네일 줄: 탭하면 그 사진으로 이동 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/strip"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp" />

    <!-- 하단 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="64dp"
            android:layout_height="72dp"
            android:background="@drawable/btn_small"
            android:text="◀"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnTrash"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:background="@drawable/btn_trash"
            android:text="🗑 휴지통"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKeep"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:background="@drawable/btn_keep"
            android:text="남기기 ▶"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

<!-- ===================== 휴지통 화면 ===================== -->
<LinearLayout
    android:id="@+id/trashScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnTrashBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/btn_small"
            android:paddingHorizontal="12dp"
            android:text="‹ 전체"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/trashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="휴지통"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/trashSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근에 지운 순서 · 기한이 지나면 자동 영구 삭제"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTrashSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/btn_small"
            android:paddingHorizontal="14dp"
            android:text="전체"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/trashGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:horizontalSpacing="2dp"
            android:numColumns="4"
            android:stretchMode="columnWidth"
            android:verticalSpacing="2dp" />

        <TextView
            android:id="@+id/trashEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="휴지통이 비어 있어요"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/trashLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnRestoreSelected"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/btn_keep"
            android:text="↶ 복원"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDeleteForever"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="@drawable/btn_trash"
            android:text="영구 삭제"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
