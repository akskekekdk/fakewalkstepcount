<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gridScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 머리말: 섬 풍경 위에 제목 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_gravity="bottom"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/header_scene" />

        <!-- 기본 머리말 -->
        <LinearLayout
            android:id="@+id/headerNormal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="44dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/gridTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="사진 정리"
                    android:textColor="@color/text"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/gridCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text2"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGridUndo"
                style="@style/Widget.PhotoClean.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="되돌리기"
                android:visibility="gone"
                app:icon="@drawable/ic_undo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenTrash"
                style="@style/Widget.PhotoClean.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="휴지통"
                app:icon="@drawable/ic_delete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.PhotoClean.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="설정"
                app:icon="@drawable/ic_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelect"
                style="@style/PhotoClean.Button3D.Green"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="선택"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 선택 모드 머리말 -->
        <LinearLayout
            android:id="@+id/headerSelect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="48dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelCancel"
                style="@style/Widget.PhotoClean.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="선택 취소"
                app:icon="@drawable/ic_close" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/selTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="길게 누른 채 끌면 여러 장 선택"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectAll"
                style="@style/PhotoClean.Button3D.Cream"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="전체 선택"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 필터 칩 -->
    <HorizontalScrollView
        android:id="@+id/chipScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFolder"
                style="@style/PhotoClean.Chip.Folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="모든 폴더"
                app:chipIcon="@drawable/ic_folder"
                app:chipIconTint="@color/wood"
                app:closeIcon="@drawable/ic_expand"
                app:closeIconEnabled="true"
                app:closeIconTint="@color/text2" />

            <View
                android:layout_width="2dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@color/outline" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@id/chipAll"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/PhotoClean.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="전체" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFav"
                    style="@style/PhotoClean.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="즐겨찾기" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBlur"
                    style="@style/PhotoClean.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="흐린 사진" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 미디어 관리 권한 안내 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/gridBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="14dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/amber_container"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/amber"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="'미디어 관리' 권한을 켜면 확인창 없이 바로 지워져요"
                android:textColor="@color/wood_dark"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bannerOn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="켜기"
                android:textColor="@color/wood_dark" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 흐린 사진 찾는 중 -->
    <LinearLayout
        android:id="@+id/blurProgressBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="8dp"
        android:paddingEnd="22dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/blurProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text2"
            android:textSize="13sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/blurProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/surface2"
            app:trackCornerRadius="6dp"
            app:trackThickness="8dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="96dp"
            android:scrollbars="none" />

        <com.photoclean.app.FastScroller
            android:id="@+id/fastScroller"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/gridEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawablePadding="14dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="32dp"
            android:textColor="@color/text2"
            android:textSize="17sp"
            android:visibility="gone"
            android:drawableTop="@drawable/illus_sprout" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/gridLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/primary" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btnResume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:text="이어서 보기"
            android:textColor="@color/on_primary"
            android:visibility="gone"
            app:backgroundTint="@color/primary"
            app:icon="@drawable/ic_play"
            app:iconTint="@color/on_primary"
            app:shapeAppearanceOverlay="@style/PhotoClean.Shape.Round" />
    </FrameLayout>

    <!-- 선택 모드 하단 -->
    <FrameLayout
        android:id="@+id/selBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="10dp"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrashSelected"
            style="@style/Widget.PhotoClean.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="사진을 골라주세요"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart" />
    </FrameLayout>
</LinearLayout>
