<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trashScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clickable="true"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrashBack"
            style="@style/Widget.PhotoClean.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="뒤로"
            app:icon="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/trashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="휴지통"
                android:textColor="@color/text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/trashSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근에 지운 순서 · 기한이 지나면 자동으로 사라져요"
                android:textColor="@color/text2"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrashSelectAll"
            style="@style/PhotoClean.Button3D.Cream"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="전체 선택"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/trashGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:horizontalSpacing="4dp"
            android:numColumns="4"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:stretchMode="columnWidth"
            android:verticalSpacing="4dp" />

        <TextView
            android:id="@+id/trashEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawablePadding="14dp"
            android:gravity="center"
            android:padding="32dp"
            android:text="휴지통이 깨끗해요 ✨"
            android:textColor="@color/text2"
            android:textSize="17sp"
            android:visibility="gone"
            android:drawableTop="@drawable/illus_sprout" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/trashLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/primary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestoreSelected"
            style="@style/PhotoClean.Button3D.Green"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="복원"
            android:textSize="16sp"
            app:icon="@drawable/ic_undo"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteForever"
            style="@style/Widget.PhotoClean.Button.Danger"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="영구 삭제"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
